{
  "manifest_version": 3,
  "name": "X Video Max Quality",
  "version": "1.1.0",
  "description": "X/Twitter 视频自动以最高画质播放（改写 HLS 主播放列表，仅保留最高档位）",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "X 视频最高画质",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png",
      "128": "icons/on-128.png"
    }
  },
  "background": {
    "service_worker": "src/bg.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"],
      "js": ["src/const.js", "src/m3u8.js", "src/hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/const.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"]
    }
  ]
}
